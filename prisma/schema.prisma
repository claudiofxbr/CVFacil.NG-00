// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ========== USERS ==========
model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  password  String?
  role      String    @default("Cliente") // 'Cliente' | 'Administrador'
  plan      String    @default("Free") // 'Free' | 'Básico' | 'Padrão' | 'Premium'
  status    String    @default("Ativo") // 'Ativo' | 'Inativo'
  credits   Int       @default(0)
  avatar    String?
  lastLogin DateTime?
  createdAt DateTime  @default(now())

  // Relations
  resumes       Resume[]
  notifications Notification[]
  payments      Payment[]

  @@map("users")
}

// ========== RESUMES ==========
model Resume {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Content
  templateId String  @default("original")
  themeMode  String  @default("light")
  fullName   String?
  role       String?
  email      String?
  phone      String?
  linkedin   String?
  portfolio  String?
  summary    String?

  // JSON fields
  experiences Json? @default("[]")
  education   Json? @default("[]")
  skills      Json? @default("[]")
  languages   Json? @default("[]")
  hobbies     Json? @default("[]")

  // Media
  avatarUrl String?

  // Sharing / i18n
  sharedToken String? @unique
  language    String? @default("pt-BR")

  // Flags
  isPinned   Boolean @default(false)
  isImported Boolean @default(false)

  // Consumo de créditos: a cada 2 alterações manuais (clique em "Salvar"),
  // 1 crédito é descontado do usuário e o contador volta a 0.
  editCount Int @default(0)

  // Timestamps
  createdAt   DateTime @default(now())
  lastUpdated DateTime @default(now()) @updatedAt

  @@index([userId, isPinned, lastUpdated])
  @@map("resumes")
}

// ========== AUDITORIA DE PAPEL DE ADMIN ==========
model AdminAuditLog {
  id           String   @id @default(cuid())
  actorId      String // quem fez a alteração
  actorEmail   String // snapshot do e-mail no momento (sobrevive se a conta for excluída depois)
  targetId     String // usuário afetado
  targetEmail  String
  previousRole String
  newRole      String
  createdAt    DateTime @default(now())

  @@index([targetId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("admin_audit_logs")
}

// ========== NOTIFICAÇÕES ==========
// Estrutura genérica: "type" é string livre (sem enum no banco) para permitir
// novos tipos de evento no futuro sem exigir migration. "data" carrega o
// payload estruturado específico de cada tipo (ex.: { amount } em credit_grant).
model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    String
  message String
  data    Json?
  read    Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, read, createdAt(sort: Desc)])
  @@map("notifications")
}

// ========== PAGAMENTOS (extrato / contas a receber) ==========
model Payment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan     String
  amount   Int // centavos
  currency String  @default("brl")
  method   String? // 'card' | 'pix' | outro — resolvido a partir do PaymentIntent no webhook
  status   String // 'paid' | 'pending' | 'failed'

  stripeSessionId       String  @unique
  stripePaymentIntentId String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("payments")
}
